DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
WELCOME_CHANNEL_ID=
LEVEL_UP_CHANNEL_ID=
STREAM_CHANNEL_ID=
STREAMER_ROLE_ID=
PING_ROLE_ID=
MOD_LOG_CHANNEL_ID=

# Persistencia del XP. Sin esto se usan los JSON de data/, que en Render
# se borran en cada redeploy. Cadena de conexion de MongoDB Atlas:
MONGODB_URI=
MONGODB_DB=sickerbot

# Kick bloquea las peticiones automaticas con Cloudflare, asi que la unica
# via es su API oficial. Se crean en kick.com/settings/developer
# Sin esto solo se vigila TikTok, que no necesita credenciales.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Canal de voz que muestra cuanta gente hay en el servidor.
# {count} se sustituye por el numero de miembros (sin contar bots).
MEMBER_COUNT_CHANNEL_ID=
MEMBER_COUNT_FORMAT=｡˚♡ Mis Rosquitas ♡˚｡ ─ {count}

# Canal y categoria que cambian de nombre solos segun si hay stream
LIVE_CHANNEL_ID=
LIVE_CATEGORY_ID=

# Nombres (opcionales, si no los pones usa estos por defecto)
LIVE_CHANNEL_NAME_ON=🔴・en-vivo
LIVE_CHANNEL_NAME_OFF=⚫・sin-stream
LIVE_CATEGORY_NAME_ON=🔴 STREAM EN VIVO
LIVE_CATEGORY_NAME_OFF=💤 SIN STREAM

# Memes automaticos de Reddit. Credenciales gratuitas: reddit.com/prefs/apps
# -> "create app" -> tipo "script". Sin esto los memes quedan desactivados.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
